# Iron Litany: four original scenes, driven by the hardware frame clock.
header.title = "IRON LITANY"
header.target = "dual"
header.cpu_speed = "double"
header.controller = "mbc5"

import includes.visuals as visuals
import includes.score as score

scene = 0
tick = 0
updates = 0
cycles = 0
previous = 0
prepared = False
paused = False
palette_step = -1

while True:
    if not prepared:
        stop_music()
        stop_sound()
        visuals.prepare(scene)
        refresh_screen()
        score.begin(scene)
        previous = frame_count()
        palette_step = -1
        updates = 0
        prepared = True
    read_buttons()
    delta = elapsed_frames(previous)
    previous = (previous + delta) & 32767
    if button_pressed("start"):
        paused = not paused
        if paused:
            pause_music()
            stop_sound()
        else:
            resume_music()
    if button_pressed("a"):
        tick = 1024
    if not paused:
        tick += delta
        if tick >= 1024:
            scene += 1
            tick = 0
            prepared = False
            if scene == 4:
                scene = 0
                cycles += 1
        else:
            if tick // 16 != palette_step:
                visuals.colors(scene, tick)
                palette_step = tick // 16
            score.rhythm(scene, tick)
            visuals.animate(scene, tick, updates, delta)
            updates += 1
    refresh_screen()
