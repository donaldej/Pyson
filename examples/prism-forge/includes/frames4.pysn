# Dispatch a zero-based frame number to its fixed asset handle. main keeps
# frame in 0..23, so one branch matches. There is no fallback for invalid
# indices here. The coordinates are tile units, not sprite/pixel units.
# draw_map changes the buffered background; main later calls refresh_screen.
def draw(frame):
    if frame == 0:
        draw_map(f0, 0, 1)
    elif frame == 1:
        draw_map(f1, 0, 1)
    elif frame == 2:
        draw_map(f2, 0, 1)
    elif frame == 3:
        draw_map(f3, 0, 1)
    elif frame == 4:
        draw_map(f4, 0, 1)
    elif frame == 5:
        draw_map(f5, 0, 1)
    elif frame == 6:
        draw_map(f6, 0, 1)
    elif frame == 7:
        draw_map(f7, 0, 1)
    elif frame == 8:
        draw_map(f8, 0, 1)
    elif frame == 9:
        draw_map(f9, 0, 1)
    elif frame == 10:
        draw_map(f10, 0, 1)
    elif frame == 11:
        draw_map(f11, 0, 1)
    elif frame == 12:
        draw_map(f12, 0, 1)
    elif frame == 13:
        draw_map(f13, 0, 1)
    elif frame == 14:
        draw_map(f14, 0, 1)
    elif frame == 15:
        draw_map(f15, 0, 1)
    elif frame == 16:
        draw_map(f16, 0, 1)
    elif frame == 17:
        draw_map(f17, 0, 1)
    elif frame == 18:
        draw_map(f18, 0, 1)
    elif frame == 19:
        draw_map(f19, 0, 1)
    elif frame == 20:
        draw_map(f20, 0, 1)
    elif frame == 21:
        draw_map(f21, 0, 1)
    elif frame == 22:
        draw_map(f22, 0, 1)
    elif frame == 23:
        draw_map(f23, 0, 1)
