def draw(frame):
    if frame == 0:
        draw_map(f0, 0, 1)
    elif frame == 1:
        draw_map(f1, 0, 1)
    elif frame == 2:
        draw_map(f2, 0, 1)
    elif frame == 3:
        draw_map(f3, 0, 1)
    elif frame == 4:
        draw_map(f4, 0, 1)
    elif frame == 5:
        draw_map(f5, 0, 1)
    elif frame == 6:
        draw_map(f6, 0, 1)
    elif frame == 7:
        draw_map(f7, 0, 1)
