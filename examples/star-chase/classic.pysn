# The compact original game keeps its loop and state together; main.pysn demonstrates modular screens.

header.title = "STAR CHASE"
header.target = "dual"

# This entire game uses the existing text, input, and integer routines.
def draw_board():
    print("                    ", 0, 0)
    print("     STAR CHASE     ", 0, 0)
    print(" Stars: 0 /10       ", 0, 1)
    print("                    ", 0, 2)
    print("+------------------+", 0, 3)
    for row in range(4, 14):
        print("|                  |", 0, row)
    print("+------------------+", 0, 14)
    print("                    ", 0, 15)
    print("@ YOU  * STAR  X FOE", 0, 16)
    print("D-pad move Start new", 0, 17)

# state: 0 = ready, 1 = playing, 2 = lost, 3 = won.
state = 0
score = 0
player_x = 3
player_y = 12
star_x = 5
star_y = 12
enemy_x = 15
enemy_y = 4
enemy_ticks = 0
enemy_axis = 0
move_ticks = 0

draw_board()
print("Collect 10 stars!", 2, 6)
print("Avoid the X", 4, 8)
print("Press Start", 4, 10)
# Commit queued drawing; refresh does not sample input.
refresh_screen()

# Run one update at a time; state survives between iterations.
while True:
    # Wait for a fresh display frame and sample buttons for this update.
    wait_vblank()

    # Start starts a new round from any screen.
    if button_pressed("start"):
        state = 1
        score = 0
        player_x = 3
        player_y = 12
        star_x = 5
        star_y = 12
        enemy_x = 15
        enemy_y = 4
        enemy_ticks = 0
        enemy_axis = 0
        move_ticks = 0
        draw_board()
        print("*", star_x, star_y)
        print("X", enemy_x, enemy_y)
        print("@", player_x, player_y)
        refresh_screen()
        continue

    if state != 1:
        continue

    old_player_x = player_x
    old_player_y = player_y
    old_enemy_x = enemy_x
    old_enemy_y = enemy_y
    old_star_x = star_x
    old_star_y = star_y
    old_score = score

    # Tap to move one tile; holding a direction repeats after a short delay.
    move_ticks += 1
    if button_pressed("right") or button("right") and move_ticks >= 8:
        if player_x < 18:
            player_x += 1
        move_ticks = 0
    elif button_pressed("left") or button("left") and move_ticks >= 8:
        if player_x > 1:
            player_x -= 1
        move_ticks = 0
    elif button_pressed("up") or button("up") and move_ticks >= 8:
        if player_y > 4:
            player_y -= 1
        move_ticks = 0
    elif button_pressed("down") or button("down") and move_ticks >= 8:
        if player_y < 13:
            player_y += 1
        move_ticks = 0

    # The enemy follows the player, alternating horizontal and vertical steps.
    # It gets slightly faster as stars are collected.
    enemy_ticks += 1
    if enemy_ticks >= 16 - score:
        enemy_ticks = 0
        if enemy_axis == 0:
            if enemy_x < player_x:
                enemy_x += 1
            elif enemy_x > player_x:
                enemy_x -= 1
            enemy_axis = 1
        else:
            if enemy_y < player_y:
                enemy_y += 1
            elif enemy_y > player_y:
                enemy_y -= 1
            enemy_axis = 0

    # Touching or crossing through the enemy ends the round.
    if player_x == enemy_x and player_y == enemy_y:
        state = 2
    elif player_x == old_enemy_x and player_y == old_enemy_y and enemy_x == old_player_x and enemy_y == old_player_y:
        state = 2

    if state == 1 and player_x == star_x and player_y == star_y:
        score += 1
        if score == 10:
            state = 3
        else:
            # Deterministic positions keep this example independent of RNG.
            star_x = (score * 7 + 3) % 18 + 1
            star_y = (score * 3 + 5) % 10 + 4
            while star_x == player_x and star_y == player_y or star_x == enemy_x and star_y == enemy_y:
                star_x = star_x % 18 + 1

    # Clear only changed tiles; the current print routine waits for VBlank.
    if player_x != old_player_x or player_y != old_player_y:
        print(" ", old_player_x, old_player_y)
    if enemy_x != old_enemy_x or enemy_y != old_enemy_y:
        print(" ", old_enemy_x, old_enemy_y)
    if score != old_score:
        print(" ", old_star_x, old_star_y)
        print("  ", 8, 1)
        print(score, 8, 1)

    if player_x != old_player_x or player_y != old_player_y or enemy_x != old_enemy_x or enemy_y != old_enemy_y or score != old_score:
        if state == 1:
            print("*", star_x, star_y)
        print("X", enemy_x, enemy_y)
        print("@", player_x, player_y)

    if state == 2:
        print("GAME OVER", 5, 8)
        print("Start to retry", 3, 10)
    elif state == 3:
        print("YOU WIN!", 6, 8)
        print("Start to replay", 3, 10)
    refresh_screen()
