# Separate movement, result transitions, and drawing while sharing state through includes.state.

import includes.state as state
import includes.graphics as art
from includes.menu import draw_end_menu, update_end_menu

def place_next_star():
    # Deterministic sequence; keep the target away from player and enemy.
    state.star_x = 1 + (state.score * 7 + 4) % 18
    state.star_y = 4 + (state.score * 5 + 8) % 11
    while tile_is_solid(art.board, state.star_x, state.star_y - 3) or (state.star_x == state.player_x and state.star_y == state.player_y) or (state.star_x == state.enemy_x and state.star_y == state.enemy_y):
        state.star_x = 1 + state.star_x % 18

def draw_game():
    print("STARS:   /10", 1, 1)
    print(state.score, 8, 1,5)
    if button("right") or button("left") or button("up") or button("down"):
        play_animation(0, art.player_walk)
    else:
        play_animation(0, art.player_idle)
    play_animation(2, art.enemy_walk)
    animated_sprite(0, state.player_x * 8, state.player_y * 8, state.facing_left)
    sprite(1, art.star, 0, state.star_x * 8, state.star_y * 8)
    animated_sprite(2, state.enemy_x * 8, state.enemy_y * 8)

# Record the result and hand control to the end-of-round menu.
def finish_round(result):
    if state.score > state.high_score:
        state.high_score = state.score
        save_write(0, state.high_score)
    if result == 3:
        play_sound("win")
    else:
        play_sound("lose")
    state.screen = result
    state.redraw = 1
    state.selection = 0

def update_game():
    update_animations()
    state.move_ticks += 1
    if button_pressed("right") or button_pressed("left") or button_pressed("up") or button_pressed("down") or state.move_ticks >= 5:
        state.move_ticks = 0
        if button("right") and not tile_is_solid(art.board, state.player_x + 1, state.player_y - 3):
            state.player_x += 1
            state.facing_left = False
        elif button("left") and not tile_is_solid(art.board, state.player_x - 1, state.player_y - 3):
            state.player_x -= 1
            state.facing_left = True
        elif button("up") and not tile_is_solid(art.board, state.player_x, state.player_y - 4):
            state.player_y -= 1
        elif button("down") and not tile_is_solid(art.board, state.player_x, state.player_y - 2):
            state.player_y += 1

    # Check the enemy's old position before moving it, preventing pass-through.
    if state.player_x == state.enemy_x and state.player_y == state.enemy_y:
        finish_round(2)
        return

    state.enemy_ticks += 1
    if state.enemy_ticks >= 22 - state.score:
        state.enemy_ticks = 0
        if state.enemy_x < state.player_x and not tile_is_solid(art.board, state.enemy_x + 1, state.enemy_y - 3):
            state.enemy_x += 1
        elif state.enemy_x > state.player_x and not tile_is_solid(art.board, state.enemy_x - 1, state.enemy_y - 3):
            state.enemy_x -= 1
        elif state.enemy_y < state.player_y and not tile_is_solid(art.board, state.enemy_x, state.enemy_y + 1 - 3):
            state.enemy_y += 1
        elif state.enemy_y > state.player_y and not tile_is_solid(art.board, state.enemy_x, state.enemy_y - 1 - 3):
            state.enemy_y -= 1

    if state.player_x == state.enemy_x and state.player_y == state.enemy_y:
        finish_round(2)
        return

    if state.player_x == state.star_x and state.player_y == state.star_y:
        state.score += 1
        if state.score == 10:
            finish_round(3)
            return
        play_sound("collect")
        place_next_star()

    draw_game()

# Draw the result state independently of ongoing gameplay updates.
def draw_result():
    clear_screen()
    art.hide_characters()
    if state.screen == 3:
        print("YOU WIN!", 6, 3,5)
        print("All stars collected", 0, 5)
    else:
        print("GAME OVER", 5, 3, 4)
        print("The enemy caught you", 0, 5)
    print("Stars:", 6, 7)
    print(state.score, 13, 7,5)
    print("Best:", 6, 9)
    print(state.high_score, 13, 9, 5)
    draw_end_menu()
    print("D-pad: choose", 3, 15)
    print("A: confirm", 5, 16)

# Dispatch one screen update and return to main for its final refresh.
def game_screen():
    if state.screen == 1:
        if state.redraw:
            art.draw_board()
            print("D-pad: move", 4, 17)
            state.redraw = 0
        update_game()
    if state.screen == 2 or state.screen == 3:
        if state.redraw:
            draw_result()
            state.redraw = 0
        update_end_menu()
