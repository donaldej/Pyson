# Immutable message strings live in ROM and are shared by the dialogue module.

intro = "WELCOME TO PYSON! THIS BOX WRAPS WORDS AND REVEALS TEXT OVER TIME. PRESS A OR START TO REVEAL THE PAGE, THEN PRESS AGAIN TO CONTINUE. THE CHARACTERS KEEP MOVING WHILE YOU READ."
garden = "THE GARDEN IS QUIET TODAY.\nA LITTLE ROBOT WALKS PAST THE FLOWERS.\nYOU CAN MOVE WHILE READING, OR PRESS B TO CLOSE THIS CONVERSATION."
