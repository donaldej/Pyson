def update(scene, tick):
    phase = tick // 32 & 15
    if scene == 0:
        scene_0(phase)
    elif scene == 1:
        scene_1(phase)
    elif scene == 2:
        scene_2(phase)
    elif scene == 3:
        scene_3(phase)
