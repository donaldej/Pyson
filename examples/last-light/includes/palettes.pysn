        bg_palette(1, "#050409", "#26182a", "#82561d", "#b8a773")
        sprite_palette(0, "#000000", "#26182a", "#82561d", "#b8a773")
        sprite_palette(1, "#000000", "#273a35", "#7f8a73", "#b8ae92")
    elif phase == 4:
        bg_palette(1, "#06050b", "#2f1d33", "#9e6a23", "#e0cc8d")
        sprite_palette(0, "#000000", "#2f1d33", "#9e6a23", "#e0cc8d")
        sprite_palette(1, "#000000", "#304641", "#9ba98d", "#e0d5b3")
    elif phase == 5:
        bg_palette(1, "#07060c", "#332038", "#ae7427", "#f6e09a")
        sprite_palette(0, "#000000", "#332038", "#ae7427", "#f6e09a")
        sprite_palette(1, "#000000", "#344d47", "#aab99a", "#f6e9c4")
    elif phase == 6:
        bg_palette(1, "#07060c", "#35213a", "#b47828", "#ffe8a0")
        sprite_palette(0, "#000000", "#35213a", "#b47828", "#ffe8a0")
        sprite_palette(1, "#000000", "#36504a", "#b0c0a0", "#fff2cb")
    elif phase == 7:
        bg_palette(1, "#07060c", "#332038", "#ae7427", "#f6e09a")
        sprite_palette(0, "#000000", "#332038", "#ae7427", "#f6e09a")
        sprite_palette(1, "#000000", "#344d47", "#aab99a", "#f6e9c4")
