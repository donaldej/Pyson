# Color choreography is ordinary palette calls. DMG keeps its grayscale fallback.

def scene_0(phase):
    if phase == 0:
        bg_palette(1, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(0, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(1, "#000000", "#000000", "#000000", "#000000")
    elif phase == 1:
        bg_palette(1, "#010102", "#0a060a", "#201607", "#2e2a1d")
        sprite_palette(0, "#000000", "#0a060a", "#201607", "#2e2a1d")
        sprite_palette(1, "#000000", "#0a0e0d", "#20231d", "#2e2c25")
    elif phase == 2:
        bg_palette(1, "#030305", "#180f1a", "#513612", "#736848")
        sprite_palette(0, "#000000", "#180f1a", "#513612", "#736848")
        sprite_palette(1, "#000000", "#182421", "#4f5648", "#736d5b")
