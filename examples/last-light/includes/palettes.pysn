def update(scene, tick):
    if tick < 48:
        phase = tick // 12
    elif tick >= 864:
        phase = max(0, (911 - tick) // 12)
    else:
        phase = 4 + (tick // 12 & 7)
    if scene == 0:
        scene_0(phase)
    elif scene == 1:
        scene_1(phase)
    elif scene == 2:
        scene_2(phase)
    elif scene == 3:
        scene_3(phase)
    elif scene == 4:
        scene_4(phase)
    elif scene == 5:
        scene_5(phase)
