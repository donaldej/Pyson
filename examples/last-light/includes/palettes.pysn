        sprite_palette(0, "#000000", "#2f1d33", "#9e6a23", "#e0cc8d")
        sprite_palette(1, "#000000", "#304641", "#9ba98d", "#e0d5b3")
    elif phase == 9:
        bg_palette(1, "#06050a", "#2a1a2e", "#8f5f20", "#cbb87f")
        sprite_palette(0, "#000000", "#2a1a2e", "#8f5f20", "#cbb87f")
        sprite_palette(1, "#000000", "#2b403b", "#8c997f", "#cbc0a1")
    elif phase == 10:
        bg_palette(1, "#050509", "#28192c", "#895b1e", "#c2b07a")
        sprite_palette(0, "#000000", "#28192c", "#895b1e", "#c2b07a")
        sprite_palette(1, "#000000", "#293d38", "#86927a", "#c2b89a")
