# Original cinematic pulse/wave score, with percussion on the other two channels.
lead_0 = music_file("../assets/score-0.json")
bass_0 = music_file("../assets/score-0.json", part=1)
lead_1 = music_file("../assets/score-1.json")
bass_1 = music_file("../assets/score-1.json", part=1)
lead_2 = music_file("../assets/score-2.json")
bass_2 = music_file("../assets/score-2.json", part=1)
lead_3 = music_file("../assets/score-3.json")
bass_3 = music_file("../assets/score-3.json", part=1)
lead_4 = music_file("../assets/score-4.json")
bass_4 = music_file("../assets/score-4.json", part=1)
lead_5 = music_file("../assets/score-5.json")
bass_5 = music_file("../assets/score-5.json", part=1)
kick = sound_effect("pulse", [[164, 1, 10], [86, 2, 8], [66, 2, 5]], priority=3, duty=2)
hat = sound_effect("noise", [[17, 1, 4], [34, 1, 2]], priority=2)
snare = sound_effect("noise", [[36, 2, 8], [49, 2, 5], [65, 2, 2]], priority=3)
last_beat = -1

def begin(scene):
    global last_beat
    last_beat = -1
    set_sound_volume(6, 6)
    if scene == 0:
        play_music(lead_0, restart=True)
        play_music(bass_0, restart=True)
    elif scene == 1:
        play_music(lead_1, restart=True)
        play_music(bass_1, restart=True)
    elif scene == 2:
        play_music(lead_2, restart=True)
        play_music(bass_2, restart=True)
    elif scene == 3:
        play_music(lead_3, restart=True)
        play_music(bass_3, restart=True)
    elif scene == 4:
        play_music(lead_4, restart=True)
        play_music(bass_4, restart=True)
    else:
        play_music(lead_5, restart=True)
        play_music(bass_5, restart=True)

def rhythm(tick):
    global last_beat
    beat = tick // 12
    if beat != last_beat:
        last_beat = beat
        if beat & 3 == 0:
            play_sound(kick)
        elif beat & 3 == 2:
            play_sound(snare)
        else:
            play_sound(hat)
    if tick >= 864:
        volume = max(0, (911 - tick) // 8)
        set_sound_volume(volume, volume)
