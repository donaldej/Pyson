def draw_scene(selected):
    if selected == 0:
        scene_0_0()
        scene_0_1()
    else:
        scene_1_0()
        scene_1_1()
    print("CODE BANKING", 4, 1)
    print("Room:", 5, 16)
    print(selected + 1, 11, 16)
    print("A/B: change room", 2, 17)
    play_sound("menu_move")
