# A new composition. The Last Light and its assets remain untouched.
header.title = "OATH OF STARS"
header.target = "dual"
header.cpu_speed = "double"
header.controller = "mbc5"
header.ram_kb = 8
header.battery = True

import includes.visuals as visuals
import includes.score as score

SCENE_FRAMES = constant(1024)
scene = 0
tick = 0
updates = 0
cycles = 0
completed = save_read(slot=0, default=0)
previous = 0
delta = 0
prepared = False
paused = False
palette_step = -1

while True:
    if not prepared:
        stop_music()
        stop_sound()
        visuals.prepare(scene, completed)
        refresh_screen()
        score.begin(scene)
        previous = frame_count()
        palette_step = -1
        updates = 0
        prepared = True
    read_buttons()
    delta = elapsed_frames(previous)
    previous = (previous + delta) & 32767
    if button_pressed("start"):
        paused = not paused
        if paused:
            pause_music()
            stop_sound()
        else:
            resume_music()
    if button_pressed("a"):
        tick = SCENE_FRAMES
    if not paused:
        tick += delta
        if tick >= SCENE_FRAMES:
            scene += 1
            tick = 0
            prepared = False
            if scene == 7:
                scene = 0
                cycles += 1
                completed = min(completed + 1, 32767)
                save_write(slot=0, value=completed)
        else:
            if tick // 16 != palette_step:
                visuals.colors(scene, tick)
                palette_step = tick // 16
            score.rhythm(scene, tick)
            visuals.animate(scene, tick, updates, delta)
            updates += 1
    refresh_screen()
