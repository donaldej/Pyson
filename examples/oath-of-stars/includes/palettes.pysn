# Literal palette choreography, synchronized with the new score.
def act_0(phase):
    if phase == 0:
        bg_palette(7, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(0, "#000000", "#000000", "#000000", "#000000")
    elif phase == 1:
        bg_palette(7, "#02040c", "#0c181e", "#163739", "#51533d")
        sprite_palette(0, "#000000", "#0c181e", "#163739", "#51533d")
    elif phase == 2:
        bg_palette(7, "#040918", "#17303c", "#2c6e72", "#a1a67b")
        sprite_palette(0, "#000000", "#17303c", "#2c6e72", "#a1a67b")
    elif phase == 3:
        bg_palette(7, "#050c20", "#204152", "#3b959c", "#dce2a7")
        sprite_palette(0, "#000000", "#204152", "#3b959c", "#dce2a7")
    elif phase == 4:
        bg_palette(7, "#060c21", "#204254", "#3d999f", "#e0e7ab")
        sprite_palette(0, "#000000", "#204254", "#3d999f", "#e0e7ab")
    elif phase == 5:
        bg_palette(7, "#060d24", "#23485b", "#42a6ad", "#f4fbba")
        sprite_palette(0, "#000000", "#23485b", "#42a6ad", "#f4fbba")
    elif phase == 6:
        bg_palette(7, "#060c23", "#224557", "#3f9fa6", "#eaf1b3")
        sprite_palette(0, "#000000", "#224557", "#3f9fa6", "#eaf1b3")
    elif phase == 7:
        bg_palette(7, "#060d23", "#224759", "#41a3aa", "#eff6b6")
        sprite_palette(0, "#000000", "#224759", "#41a3aa", "#eff6b6")
