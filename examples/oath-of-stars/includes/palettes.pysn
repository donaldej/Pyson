def update(scene, tick):
    if tick < 64:
        phase = tick // 16
    elif tick >= 960:
        phase = max(0, (1023 - tick) // 16)
    else:
        phase = 4 + (tick // 16 & 3)
    foreground(phase)
    if scene == 0:
        act_0(phase)
    elif scene == 1:
        act_1(phase)
    elif scene == 2:
        act_2(phase)
    elif scene == 3:
        act_3(phase)
    elif scene == 4:
        act_4(phase)
    elif scene == 5:
        act_5(phase)
    elif scene == 6:
        act_6(phase)

# Foreground palettes follow the same fade as the scenery.
def foreground(phase):
    if phase == 0:
        sprite_palette(1, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(2, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(3, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(4, "#000000", "#000000", "#000000", "#000000")
        sprite_palette(5, "#000000", "#000000", "#000000", "#000000")
    elif phase == 1:
        sprite_palette(1, "#000000", "#0d111b", "#2d3231", "#4d4941")
        sprite_palette(2, "#000000", "#0d101b", "#2d2835", "#51422c")
        sprite_palette(3, "#000000", "#11161f", "#333f45", "#525145")
        sprite_palette(4, "#000000", "#191224", "#3d323a", "#545040")
        sprite_palette(5, "#000000", "#0c1d27", "#263f41", "#545248")
    elif phase == 2:
        sprite_palette(1, "#000000", "#1a2235", "#5a6462", "#9a9383")
        sprite_palette(2, "#000000", "#1a2036", "#5a4f6a", "#a28457")
        sprite_palette(3, "#000000", "#232c3f", "#677d8b", "#a3a28b")
        sprite_palette(4, "#000000", "#322449", "#7a6474", "#a8a081")
        sprite_palette(5, "#000000", "#183b4d", "#4d7d81", "#a8a48f")
    else:
        sprite_palette(1, "#000000", "#273451", "#889894", "#e9dec6")
        sprite_palette(2, "#000000", "#283152", "#8878a0", "#f6c884")
        sprite_palette(3, "#000000", "#35435f", "#9cbed2", "#f7f5d2")
        sprite_palette(4, "#000000", "#4b366e", "#b997af", "#fff2c3")
        sprite_palette(5, "#000000", "#245975", "#74bec4", "#fff8d9")
