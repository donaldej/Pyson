# SHADOW TERMINAL: NEON RAIN. Original neon-noir imagery and music.
# The corporate alert carries a live DEFCON countdown; there are no scene labels.
header.title = "NEON RAIN"
header.target = "dual"
header.controller = "mbc5"
header.cpu_speed = "double"
import includes.art as art
import includes.overlay as overlay
import includes.score as score

scene = 0
tick = 0
cycles = 0
previous = 0
prepared = False
paused = False
last_frame = -1
last_second = -1
level = 0
remaining = 0

while True:
    if not prepared:
        stop_sound()
        for slot in range(40):
            hide_sprite(slot)
        clear_screen()
        art.colors(scene)
        art.draw(scene, 0)
        level = 0
        if scene == 2:
            level = 5
            remaining = 2
            overlay.readiness(level, remaining)
        refresh_screen()
        score.begin(scene)
        previous = frame_count()
        last_frame = -1
        last_second = -1
        prepared = True
    read_buttons()
    delta = elapsed_frames(previous)
    previous = (previous+delta) & 32767
    if button_pressed("start"):
        paused = not paused
        if paused:
            score.pause()
            stop_sound()
        else:
            score.resume()
    if button_pressed("a"):
        tick = 600
    if not paused:
        tick += delta
        if tick >= 600:
            tick = 0
            scene += 1
            if scene == 5:
                scene = 0
                cycles += 1
            prepared = False
        else:
            score.update()
            frame = tick // 8 % 24
            if frame != last_frame:
                art.draw(scene, frame)
                last_frame = frame
            if scene == 2:
                second = tick // 60
                if second != last_second:
                    last_second = second
                    level = 5-tick // 120
                    remaining = 2-tick % 120 // 60
                    overlay.readiness(level, remaining)
            art.weather(tick)
    refresh_screen()
