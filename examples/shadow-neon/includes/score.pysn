# Neon Rain: original suspended noir melodies and warm arpeggiated wave bass.
lead0 = music_file("../assets/score-0.json")
bass0 = music_file("../assets/score-0.json", part=1)
lead1 = music_file("../assets/score-1.json")
bass1 = music_file("../assets/score-1.json", part=1)
lead2 = music_file("../assets/score-2.json")
bass2 = music_file("../assets/score-2.json", part=1)
kick = sound_effect("pulse", [[98,2,9],[65,3,5]], duty=1)
snare = sound_effect("noise", [[53,2,6],[79,3,3]])
hat = sound_effect("noise", [[4,1,2]])
last_beat = -1
current = -1
origin = 0
paused_at = 0

def begin(scene):
    global last_beat, current, origin
    movement = 0
    if scene >= 2 and scene < 4:
        movement = 1
    elif scene == 4:
        movement = 2
    if movement == current:
        return
    current = movement
    last_beat = -1
    set_sound_volume(6, 6)
    if movement == 0:
        play_music(lead0, restart=True)
        play_music(bass0, restart=True)
    elif movement == 1:
        play_music(lead1, restart=True)
        play_music(bass1, restart=True)
    else:
        play_music(lead2, restart=True)
        play_music(bass2, restart=True)
    origin = frame_count()

def pause():
    global paused_at
    paused_at = frame_count()
    pause_music()

def resume():
    global origin
    origin = (origin+elapsed_frames(paused_at)) & 32767
    resume_music()

def update():
    global last_beat
    # This clock preserves percussion phase across visual changes and pauses.
    beat = elapsed_frames(origin) // 8
    if beat != last_beat:
        last_beat = beat
        # Kick and snare use different channels, so both can hit together.
        # There are no warning beeps at transitions or during DEFCON 1.
        step = beat % 16
        if step == 0 or step == 10:
            play_sound(kick)
        if step == 8:
            play_sound(snare)
        elif step % 2 == 1:
            play_sound(hat)
