# Two four-shade pictures, independent CGB accents, and automatic DMG fallback.
# The second shape passes in front; its dark outline also hides rear colors.
header.title="MASKED COLORS"
header.target="dual"
header.controller="mbc5"
shapes=masked_sheet("assets/shapes.bmp",16,24)
colored=True
clear_screen()
bg_palette(0,"#081828","#486078","#90A0B0","#E8F0D8")
sprite_palette(0,"#081828","#703848","#C85870","#FFD8C0")
sprite_palette(1,"#081828","#184078","#3888C8","#C8F0F8")
print("MASKED COLOR LAYERS",1,1)
if is_cgb():
    print("GAME BOY COLOR",3,3)
else:
    print("ORIGINAL GB SHADES",1,3)
print("A: TOGGLE ACCENTS",1,16)
began=frame_count()
while True:
    # A changes only the color treatment. The bodies use the same image.
    if button_pressed("a"):
        colored=not colored
    if colored:
        masked_palette(0,index=0)
        masked_palette(1,index=1)
    else:
        masked_palette(0)
        masked_palette(1)
    distance=elapsed_frames(began)%160
    if distance>80:
        distance=160-distance
    draw_masked(0,shapes,0,24+distance,56)
    draw_masked(1,shapes,1,120-distance,64,flip_x=True)
    refresh_screen()
    wait_frames(1)
