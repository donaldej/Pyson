# A scene/tick coordinator selects visuals and music for a repeating noninteractive show.

header.title = "NEON REQUIEM"
header.target = "cgb"
import includes.visuals as visuals
import includes.score as score

SECTION_TICKS = constant(512)
scene = 0
tick = 0
cycles = 0
# Run one update at a time; state survives between iterations.
while True:
    if tick == 0:
        stop_music()
        stop_sound()
        visuals.prepare(scene)
        visuals.colors(0)
        # Commit queued drawing; refresh does not sample input.
        refresh_screen()
        score.begin(scene)
    if tick & 3 == 0:
        visuals.colors(tick)
    score.percussion(tick, scene)
    if scene == 0:
        visuals.space(tick)
    elif scene == 1:
        visuals.flyover(tick)
    elif scene == 2:
        visuals.reactor(tick)
    else:
        visuals.reveal(tick)
    # Refresh provides the single cooperative audio tick; no second wait here.
    refresh_screen()
    tick += 1
    if tick >= SECTION_TICKS:
        tick = 0
        scene += 1
        if scene >= 4:
            scene = 0
            cycles = (cycles + 1) % 32000
