# SHADOW TERMINAL: IRON ECLIPSE, a military hologram demonstration.
# There are no scene-name captions. The terminal name and countdown are the
# only foreground lettering, apart from the small Pyson credit in the finale.
header.title = "IRON ECLIPSE"
header.target = "dual"
header.controller = "mbc5"
header.cpu_speed = "double"
import includes.art as art
import includes.overlay as overlay
import includes.score as score

scene = 0
tick = 0
cycles = 0
previous = 0
prepared = False
paused = False
last_frame = -1
last_second = -1
last_compact = False
level = 0
remaining = 0
duration = 360

while True:
    if not prepared:
        # Adjacent DEFCON levels can share a continuous musical movement.
        stop_sound()
        for slot in range(40):
            hide_sprite(slot)
        clear_screen()
        art.colors(scene)
        art.draw(scene, 0)
        if scene == 0:
            level = 0
            duration = 360
            overlay.brand(False)
        elif scene == 6:
            level = 0
            duration = 480
            overlay.brand(True)
        else:
            level = 6-scene
            duration = 600
            remaining = 10
            overlay.readiness(level, remaining, False)
        refresh_screen()
        score.begin(scene)
        previous = frame_count()
        last_frame = -1
        last_second = -1
        last_compact = False
        prepared = True

    read_buttons()
    delta = elapsed_frames(previous)
    previous = (previous+delta) & 32767
    if button_pressed("start"):
        paused = not paused
        if paused:
            score.pause()
            stop_sound()
        else:
            score.resume()
    if button_pressed("a"):
        tick = duration
    if not paused:
        tick += delta
        if tick >= duration:
            tick = 0
            scene += 1
            if scene == 7:
                scene = 0
                cycles += 1
            prepared = False
        else:
            score.update()
            # Introduce each level with a large number for two seconds. The
            # later images open the center for the military hologram itself.
            frame = tick // 6 % 48
            if level > 0:
                if tick < 120:
                    frame = tick // 10
                else:
                    frame = 12+(tick-120) // 6 % 36
            if frame != last_frame:
                art.draw(scene, frame)
                last_frame = frame
            if level > 0:
                second = tick // 60
                compact = tick >= 120
                if second != last_second or compact != last_compact:
                    last_second = second
                    last_compact = compact
                    remaining = 10-second
                    overlay.readiness(level, remaining, compact)
            overlay.pulse(tick)
    refresh_screen()
