# Sprites keep the live text independent of the changing background clip.
# Numbers use 12 components, small characters use one component each.
import includes.art as art
import includes.labels as labels

def brand(finale):
    for i in range(6):
        sprite(i, art.letters, labels.shadow[i], 56+i*8, 96)
    for i in range(8):
        sprite(6+i, art.letters, labels.terminal[i], 48+i*8, 112)
    if finale:
        for i in range(5):
            sprite(14+i, art.letters, labels.pyson[i], 60+i*8, 136)

def readiness(level, remaining, compact):
    # Clear only the extra components of the large digit. Keeping the other
    # live sprites avoids blanking the status display on every timer update.
    if compact:
        for slot in range(7,18):
            hide_sprite(slot)
    x = 56
    y = 32
    time_x = 60
    time_y = 88
    if compact:
        x = 88
        y = 8
        time_x = 104
        time_y = 24
    for i in range(6):
        sprite(i, art.letters, labels.defcon[i], x+i*8, y)
    # Frames 0..4 contain the digits 1..5. This call occupies slots 6..17.
    if compact:
        sprite(6, art.letters, level, 144, 8)
    else:
        sprite(6, art.numbers, level-1, 68, 48)
    sprite(18, art.letters, 0, time_x, time_y)
    sprite(19, art.letters, 0, time_x+8, time_y)
    sprite(20, art.letters, labels.colon, time_x+16, time_y)
    sprite(21, art.letters, remaining // 10, time_x+24, time_y)
    sprite(22, art.letters, remaining % 10, time_x+32, time_y)
    # Each escalation illuminates another readiness lamp.
    for i in range(5):
        if i >= level-1:
            sprite(23+i, art.marks, 0, 16+i*30, 128)
        else:
            hide_sprite(23+i)

def pulse(tick):
    # Side markers now sweep in two axes, staying outside the countdown.
    for i in range(4):
        y = 16+i*32+(tick // 4+i*2) % 8
        offset = (tick // 7+i) % 3
        sprite(28+i, art.marks, 1, 8+offset*8, y)
        sprite(32+i, art.marks, 1, 144-offset*8, y)
    # Four packet tracers race along the outer rails. All 40 components can
    # be addressed, while their vertical separation keeps scanline costs low.
    for i in range(2):
        # The upper rail stays left of the compact status display.
        x = 16+(tick+i*30) % 60
        sprite(36+i, art.marks, 0, x, 8)
        sprite(38+i, art.marks, 0, 152-x, 128)
